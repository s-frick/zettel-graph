{
  "name": "zettel-graph",
  "version": "0.2.0",
  "description": "3D force-directed visualizer for OKF (Open Knowledge Format) bundles, with hot-reload. CLI-first: point it at a directory of markdown and explore the graph.",
  "type": "module",
  "license": "MIT",
  "author": "Sebastian Frick",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s-frick/zettel-graph.git"
  },
  "keywords": [
    "okf",
    "open-knowledge-format",
    "knowledge-graph",
    "zettelkasten",
    "force-graph",
    "3d",
    "markdown",
    "visualization"
  ],
  "bin": {
    "zettel-graph": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "index.html",
    "vite.config.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node bin/cli.js dev examples",
    "build": "node bin/cli.js build examples",
    "graph": "node bin/cli.js graph examples"
  },
  "dependencies": {
    "3d-force-graph": "^1.73.4",
    "chokidar": "^4.0.3",
    "force-graph": "^1.51.4",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.10.0",
    "marked": "^14.1.3",
    "mermaid": "^11.17.0",
    "three": "^0.185.0",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=18"
  }
}
